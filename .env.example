# 42 API Credentials
# Get your API credentials from https://profile.intra.42.fr/oauth/applications

# Single key mode (simple):
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Multi-key mode (for higher rate limits):
# Each key can make up to 1200 requests per hour.
# Add as many key pairs as you need. Numbered keys take priority over the single key above.
# CLIENT_ID_1=your_first_client_id
# CLIENT_SECRET_1=your_first_client_secret
# CLIENT_ID_2=your_second_client_id
# CLIENT_SECRET_2=your_second_client_secret
# CLIENT_ID_3=your_third_client_id
# CLIENT_SECRET_3=your_third_client_secret
